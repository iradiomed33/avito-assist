APP_NAME=avito-assist
ENV=dev
BASE_URL=http://localhost:8000

# DB
DATABASE_URL=sqlite:///./avito_assist.db

# Auth
JWT_SECRET=CHANGE_ME_SUPER_SECRET
JWT_EXPIRE_MIN=43200

# CORS
CORS_ORIGINS=http://localhost:5173


# Later (Sprint 2+)
PERPLEXITY_API_KEY=
PERPLEXITY_BASE_URL=https://api.perplexity.ai


# Avito OAuth
AVITO_CLIENT_ID=put_here
AVITO_CLIENT_SECRET=put_here
AVITO_REDIRECT_URL=https://ai-dialog-bot.ru/avito/oauth/callback
AVITO_AUTH_URL=https://avito.ru/oauth
AVITO_TOKEN_URL=https://api.avito.ru/token
AVITO_SCOPES=items:info messenger:read messenger:write short_term_rent:read stats:read user:read
